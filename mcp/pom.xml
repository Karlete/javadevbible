<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>dev.javadevbible</groupId>
    <artifactId>javadevbible-mcp</artifactId>
    <version>1.0.0</version>
    <name>JavaDevBible MCP Server</name>
    <description>
        MCP server that exposes JavaDevBible content to AI assistants.
        Runs as a STDIO subprocess — no ports, no auth, no network.
    </description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            MCP server over STDIO.
            spring-ai-starter-mcp-server includes the STDIO transport.
            No web starter — this process communicates via stdin/stdout, not HTTP.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>

        <!--
            JSON parsing for search-index.json and HTML text extraction.
            Jackson 3 ships with Spring Boot 4 — no explicit version needed.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!--
                    Produces a fat JAR: target/javadevbible-mcp-1.0.0.jar
                    Claude Desktop launches this JAR as a subprocess.
                -->
            </plugin>
        </plugins>
    </build>
</project>
